# Copy to .env and edit. `.env` is gitignored; this file is not, so never put a
# real key or password in here.
#
#   cp .env.example .env
#
# Docker Compose reads .env from this directory automatically and passes these
# through to the containers (see the `environment:` blocks in
# docker-compose.yml). Every variable below has a working default, so the only
# one you normally have to set is GEMINI_API_KEY.

# =============================================================================
# REQUIRED
# =============================================================================

# The AI chat has no offline fallback: without a key every chat request answers
# HTTP 503 by design, rather than faking a reply. Get one from
# https://aistudio.google.com/apikey — or set LLM_PROVIDER=ollama below and run
# the model locally instead.
GEMINI_API_KEY=your_gemini_api_key_here

# Signs every JWT. The default in config.py and docker-compose.yml is published
# in this repository, so anyone could forge a token for any account with it —
# the server logs a warning at startup while it is still in use. Generate one:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace_me_with_openssl_rand_hex_32

# =============================================================================
# DATABASE
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=se_ml_effy
# Host is the compose service name, not localhost: this is resolved from inside
# the backend container.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/se_ml_effy

# =============================================================================
# LLM PROVIDER ("gemini" | "ollama")
# =============================================================================

LLM_PROVIDER=gemini

# --- Gemini (default) --------------------------------------------------------
# Older ids (2.5, 2.0, 1.5) are being closed to new projects and answer
# NOT_FOUND at call time even though list_models() still returns them; the
# client retires such an id for the process and falls back automatically.
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama (local model) ----------------------------------------------------
# Also start the container: `docker compose --profile ollama up -d`.
# Needs ~5GB of free RAM in the Docker VM; below that the model runner is
# OOM-killed mid-generation and every chat request returns HTTP 503.
OLLAMA_BASE_URL=http://ollama:11434
# Must be a tool-calling model.
OLLAMA_MODEL=llama3.1:8b
# Seconds. A cold model load plus a multi-step reschedule takes several
# round-trips.
OLLAMA_TIMEOUT=300
# Context window per request. The agent prompt (scheduling rules + course
# grounding + long-term memory + tool schemas) does not fit in Ollama's
# 4096-token default, and an over-long prompt is truncated silently — which
# drops the tool definitions.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=800
# Greedy decoding: scheduling is extraction, not creative writing.
OLLAMA_TEMPERATURE=0.0
# Tool-calling rounds before the model is asked for a final answer with the
# tools withheld.
OLLAMA_MAX_TOOL_TURNS=4
OLLAMA_KEEP_ALIVE=24h

# =============================================================================
# TIME
# =============================================================================

# Wall-clock zone used when a user's browser has not reported theirs. The chat
# request carries the browser's zone and that always wins, so this only covers
# older clients and anything server-initiated. Set it to your own zone — on the
# default (UTC) an unreported user's "6pm" is stored as 18:00 UTC and the
# calendar renders it at their real offset (21:00 at UTC+3).
DEFAULT_TIMEZONE=Asia/Jerusalem

# =============================================================================
# AUTH & TOKEN LIFETIMES
# =============================================================================

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# ABUSE PROTECTION
# =============================================================================
# Keyed per authenticated user rather than per IP, so one account cannot hide
# behind a shared campus NAT and a shared NAT cannot throttle everyone on it.
# Exceeding a limit returns HTTP 429. Format: "<count>/<period>".

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_POST=5/minute
RATE_LIMIT_COMMENT=15/minute
RATE_LIMIT_MESSAGE=20/minute
RATE_LIMIT_REACTION=60/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_MEMORY=30/minute

# =============================================================================
# APP & FRONTEND
# =============================================================================

PROJECT_NAME=SE_ML_effy
# JSON list, parsed by pydantic-settings. Must include the origin the browser
# loads the frontend from, or every request fails CORS.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Where the browser reaches the backend. Read at Vite build/dev time.
VITE_API_URL=http://localhost:8000
