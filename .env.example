POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=se_ml_effy
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/se_ml_effy
JWT_SECRET_KEY=se_ml_effy_super_secret_jwt_key_change_in_production_32bytes

# LLM Provider Configuration ("gemini" | "ollama")
LLM_PROVIDER=gemini

# Gemini AI API Configuration. Required when LLM_PROVIDER=gemini — the chat path
# has no offline fallback and fails loudly without a key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Local LLM fallback (LLM_PROVIDER=ollama) ---------------------------------
# Also start the container: `docker compose --profile ollama up -d`.
# Needs ~5GB of free RAM in the Docker VM; below that the model runner is
# OOM-killed mid-generation and every chat request returns HTTP 503.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

VITE_API_URL=http://localhost:8000
